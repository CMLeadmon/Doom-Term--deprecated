{
  "name": "doom-term",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cargo run --manifest-path backend/Cargo.toml --release",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sidecar": "npm run sidecar:daemon && npm run sidecar:tmux",
    "sidecar:daemon": "node tools/build-sidecar.mjs",
    "sidecar:tmux": "node tools/build-tmux-sidecar.mjs",
    "tauri": "tauri",
    "test": "node --test \"src/**/*.test.js\" \"tools/**/*.test.mjs\" && vitest run",
    "test:ui": "node tools/test-frontend-ui.mjs",
    "typecheck": "tsc --noEmit",
    "cargo:check": "cargo check",
    "cargo:test": "cargo test",
    "check:tauri": "node tools/check-tauri.mjs",
    "agent:verify": "npm run typecheck && npm test && npm run build && npm run hud:check && npm run cargo:check && npm run cargo:test && npm run check:tauri",
    "hud:ref": "node tools/hud/cli.js render docs/design/reference/plate-480@1x.png --scale 1 && node tools/hud/cli.js render docs/design/reference/plate-480@4x.png --scale 4",
    "hud:check": "node tools/hud/cli.js render .artifacts/plate-reference-check.png --scale 1 && node tools/hud/cli.js compare docs/design/reference/plate-480@1x.png .artifacts/plate-reference-check.png --out .artifacts/plate-diff.png",
    "hud:check:browser": "node tools/hud/cli.js compare docs/design/reference/plate-480@1x.png .artifacts/plate-actual.png --out .artifacts/plate-browser-diff.png --if-exists"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
